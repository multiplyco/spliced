{
  "name": "spliced-app",
  "version": "1.1.0",
  "description": "A workshop for motion design: study the films you love scene by scene, name their moves, and build your own films from them with your AI.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/multiplyco/spliced.git"
  },
  "homepage": "https://spliced.video",
  "bugs": {
    "url": "https://github.com/multiplyco/spliced/issues"
  },
  "keywords": [
    "motion design",
    "video",
    "remotion",
    "mcp",
    "claude",
    "film",
    "reference library"
  ],
  "bin": {
